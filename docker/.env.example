# Optional — NOT required on the server.
# Production secrets live in /opt/bobaclaw/data/config.yaml (bind-mounted to /data).
#
# Use this file for local overrides: image tags, logging, compose port, gateway token.
#   cp docker/.env.example docker/.env      (docker/.env is gitignored — never commit it)

# Images (CI sets these on deploy; override for local builds)
BOBACLAW_IMAGE=bobaclaw/bobaclaw:latest
BOBACLAW_SANDBOX_IMAGE=bobaclaw/sandbox:latest
OBSCURA_MCP_IMAGE=h4ckf0r0day/obscura

# Gateway port on the host (published on 127.0.0.1 only)
BOBACLAW_GATEWAY_PORT=18790

# Gateway bearer token — REQUIRED for the container deployment (the gateway refuses to
# start on its 0.0.0.0 container bind without one). If unset here and in the environment,
# scripts/docker-prod-deploy.sh reads or generates $BOBACLAW_DATA_DIR/gateway-token (0600).
# Clients: curl -H "Authorization: Bearer $BOBACLAW_GATEWAY_TOKEN" http://127.0.0.1:18790/api/agent
#   generate: openssl rand -hex 32
# BOBACLAW_GATEWAY_TOKEN=

# Docker API filter in front of /var/run/docker.sock (gateway uses DOCKER_HOST=tcp://docker-socket-proxy:2375)
# DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.5.0

# Pull sandbox + obscura on container start (1 = yes)
BOBACLAW_PULL_IMAGES=1

# Logging
# RUST_LOG=bobaclaw=info
